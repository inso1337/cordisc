{
  "name": "cordisc",
  "version": "0.1.0",
  "description": "Compiler layer for the Cordis context paradigm: static coeffect checking, Context augmentation codegen, and effect state-machine lowering",
  "main": "./dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "pretest": "tsc",
    "prepack": "tsc"
  },
  "keywords": [
    "cordis",
    "coeffects",
    "effects",
    "static-analysis",
    "compiler",
    "plugin-system"
  ],
  "author": "Thomas Moussajee",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cordisc": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "cordis": "^4.0.0-rc.8"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inso1337/cordisc.git"
  },
  "engines": {
    "node": ">=22.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
